# ─────────────────────────────────────────────────────────────────────
#  Soul Society — 𓆩 𝐕𝐎𝐈𝐃𝐖𝐎𝐑𝐊𝐒 𓆪 — KNIGHT + AEGIS configuration
#  Copy to .env (never commit .env). Run: npm run check:config
# ─────────────────────────────────────────────────────────────────────

# Your Discord user ID (Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID).
# Only this ID (plus TRUSTED_USER_IDS) can use ALPHA natural-language and voice commands.
OWNER_ID=

# Optional extra users allowed to use ALPHA (comma-separated IDs). Leave empty unless needed.
TRUSTED_USER_IDS=

# Two SEPARATE Discord applications (https://discord.com/developers/applications).
# Bot tab → Reset Token. Enable "Server Members Intent" and "Message Content Intent" for BOTH.
KNIGHT_TOKEN=
AEGIS_TOKEN=
# Client IDs are derived from the tokens automatically; set them only if derivation fails.
KNIGHT_CLIENT_ID=
AEGIS_CLIENT_ID=

# Register slash commands instantly in one test server (recommended). Leave empty for global registration.
DEV_GUILD_ID=

# IANA time zone for daily rewards, reports and schedules.
TIMEZONE=Asia/Kolkata

# ── Optional hosted AI + speech-to-text (Groq free plan: no payment method required) ──
# Get a key at https://console.groq.com/keys . Leave empty to run fully deterministic (no AI, no voice transcription).
GROQ_API_KEY=
# none | groq   (defaults to groq when GROQ_API_KEY is set)
AI_PROVIDER=
AI_MODEL=llama-3.1-8b-instant
# Local safety caps (stay well below Groq's free limits; never auto-upgrades to paid).
AI_DAILY_LIMIT=300
# none | groq | mock   (mock = SIMULATED transcripts for testing only)
STT_PROVIDER=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
STT_DAILY_LIMIT=1500

# Spoken ALPHA replies using the speech engine built into Windows (no download). Also enable per server with /setup alpha speak:true
TTS_ENABLED=false

# ── Music (lawful sources only; see docs/MUSIC.md) ──
# Folder with your own audio files named "Artist - Title.mp3" (default: data/music)
MUSIC_DIR=
MUSIC_ENABLE_ARCHIVE=true
MUSIC_ENABLE_RADIO=false
MUSIC_IDLE_LEAVE_SECONDS=300

# ── Research ──
# Extra RSS/Atom feeds to search (comma-separated). Publisher feeds you are allowed to use.
RESEARCH_RSS_FEEDS=
# Google News RSS terms limit it to personal, non-commercial feed readers; off by default.
RESEARCH_ENABLE_GOOGLE_NEWS=false

# ── Welcome card ──
# Path to your ORIGINAL Soul Society background (default: assets/welcome/background.png)
WELCOME_BACKGROUND=

# ── Storage & logs ──
DB_PATH=data/soul-society.db
LOG_DIR=data/logs
LOG_LEVEL=info
BACKUP_DIR=data/backups
BACKUP_KEEP=7
APPROVAL_TTL_SECONDS=120
