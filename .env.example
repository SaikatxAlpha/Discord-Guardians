# ─────────────────────────────────────────────────────────────────────
#  Soul Society — KNIGHT + AEGIS — LOCAL DEVELOPMENT configuration
#  Copy to .env (never commit .env). Run: npm run check:config
#  For a server/container use .env.production.example instead.
# ─────────────────────────────────────────────────────────────────────

# development (default) | production
APP_ENV=development

# Two SEPARATE Discord applications. Enable "Server Members" and
# "Message Content" intents for both (Developer Portal → Bot).
KNIGHT_TOKEN=
AEGIS_TOKEN=
# Derived from the tokens automatically; set only if derivation fails.
KNIGHT_CLIENT_ID=
AEGIS_CLIENT_ID=

# Development server: with DEV_GUILD_ID set (and APP_ENV=development) slash
# commands register instantly in that server only. Production uses global commands.
DEV_GUILD_ID=
# guild | global (default: guild when DEV_GUILD_ID is set in development)
COMMAND_SCOPE=

# Bot operator (your Discord user ID). Each server's OWNER always controls
# ALPHA there; add others per server with /setup trusted.
OWNER_ID=
# true = the operator (and TRUSTED_USER_IDS) may use ALPHA in EVERY server.
OPERATOR_GLOBAL_ACCESS=false
TRUSTED_USER_IDS=

TIMEZONE=Asia/Kolkata

# ── Optional Groq (free plan, no payment method): voice transcription + AI fallback ──
# https://console.groq.com/keys
GROQ_API_KEY=
# none | groq   (defaults to groq when GROQ_API_KEY is set)
AI_PROVIDER=none
AI_MODEL=llama-3.1-8b-instant
AI_DAILY_LIMIT=300
# none | groq | mock (mock = simulated, tests only)
STT_PROVIDER=
# whisper-large-v3-turbo (default: faster, cheaper) | whisper-large-v3 (≈2.8× cost)
STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 code (en, hi, es…) or "auto". Servers can override with /voice settings.
STT_LANGUAGE=en
# Extra words for the recognition prompt (optional; servers add their own with /voice settings)
STT_PROMPT=
STT_DAILY_LIMIT=1500
STT_GUILD_DAILY_LIMIT=400
STT_TIMEOUT_MS=15000
STT_MAX_RETRIES=1

# ── Voice behaviour ──
WAKE_WORD=ALPHA
# Silence that ends an utterance (ms). Raise if you speak with long pauses.
VOICE_SILENCE_MS=1100
VOICE_MAX_UTTERANCE_MS=15000
# Below REPEAT: "please repeat". Below CONFIRM: ask before changing anything.
VOICE_REPEAT_BELOW=0.45
VOICE_CONFIRM_BELOW=0.7
# Spoken replies with the Windows speech engine (Windows only).
TTS_ENABLED=false

# ── Music (online, licensed sources — no local files needed) ──
# Order = search priority. audius needs no key; jamendo needs JAMENDO_CLIENT_ID (free);
# local is an optional folder (MUSIC_DIR) and is skipped if it does not exist.
MUSIC_PROVIDERS=audius,jamendo,archive,radio,local
JAMENDO_CLIENT_ID=
MUSIC_ENABLE_ARCHIVE=true
MUSIC_ENABLE_RADIO=false
MUSIC_DIR=
MUSIC_IDLE_LEAVE_SECONDS=300
MUSIC_MAX_QUEUE=100
MUSIC_MAX_STREAMS=8
MUSIC_DEFAULT_VOLUME=70

# ── Research ──
RESEARCH_RSS_FEEDS=
RESEARCH_ENABLE_GOOGLE_NEWS=false

# ── Welcome card default background (servers can upload their own) ──
WELCOME_BACKGROUND=

# ── Storage & logs ──
DATA_DIR=data
DB_PATH=
LOG_DIR=
LOG_TO_FILE=true
LOG_LEVEL=info
BACKUP_KEEP=7
APPROVAL_TTL_SECONDS=120
# Optional HTTP health endpoint port for hosts that require one
HEALTH_PORT=
