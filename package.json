{
  "name": "soul-society",
  "version": "1.0.0",
  "description": "VOIDWORKS Soul Society — KNIGHT + AEGIS guardian Discord bots with the shared ALPHA core",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning apps/launcher.js",
    "start:single": "node --disable-warning=ExperimentalWarning apps/single.js",
    "knight": "node --disable-warning=ExperimentalWarning apps/knight/index.js",
    "aegis": "node --disable-warning=ExperimentalWarning apps/aegis/index.js",
    "register": "node --disable-warning=ExperimentalWarning apps/register-commands.js",
    "check:config": "node --disable-warning=ExperimentalWarning scripts/check-config.js",
    "check:discord": "node --disable-warning=ExperimentalWarning scripts/check-discord.js",
    "health": "node --disable-warning=ExperimentalWarning scripts/health.js",
    "simulate": "node --disable-warning=ExperimentalWarning scripts/simulate.js",
    "render:welcome": "node --disable-warning=ExperimentalWarning scripts/render-welcome.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "verify:media": "node --disable-warning=ExperimentalWarning scripts/verify-media.js",
    "benchmark:stt": "node --disable-warning=ExperimentalWarning scripts/benchmark-stt.js",
    "check:production": "node --disable-warning=ExperimentalWarning scripts/check-production.js",
    "healthcheck": "node --disable-warning=ExperimentalWarning scripts/healthcheck.js",
    "smoke:login": "node --disable-warning=ExperimentalWarning scripts/smoke-login.js"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "^14.27.0",
    "fast-xml-parser": "^5.11.2",
    "gifenc": "^1.0.3",
    "mpg123-decoder": "^1.0.3",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  }
}
