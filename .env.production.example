# ─────────────────────────────────────────────────────────────────────
#  Soul Society — PRODUCTION environment (template, placeholders only)
#  On the server:  cp .env.production.example .env.production
#                  nano .env.production        (fill in, then chmod 600)
#  Never commit .env.production. Hosting providers with a secret manager:
#  enter these as secrets/environment variables there instead.
# ─────────────────────────────────────────────────────────────────────

APP_ENV=production
# Slash commands registered globally so they work in every server the bots join.
COMMAND_SCOPE=global

# Bot tokens (two separate Discord applications).
KNIGHT_TOKEN=
AEGIS_TOKEN=

# Bot operator (your Discord user ID). In production this does NOT give you
# control of other people's servers unless OPERATOR_GLOBAL_ACCESS=true.
OWNER_ID=
OPERATOR_GLOBAL_ACCESS=false

TIMEZONE=Asia/Kolkata

# Optional: Groq (free plan, no card) for voice transcription and the AI fallback.
GROQ_API_KEY=
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
STT_DAILY_LIMIT=1500
STT_GUILD_DAILY_LIMIT=400
AI_PROVIDER=none

# Music providers (Audius needs no key). Jamendo needs a free client id.
MUSIC_PROVIDERS=audius,jamendo,archive,radio
JAMENDO_CLIENT_ID=
MUSIC_ENABLE_RADIO=false
# 256 MB hosts: 2. Each stream ≈ 20–35 MB with the built-in decoder.
MUSIC_MAX_STREAMS=2
MUSIC_METADATA_CATALOG=true
# Optional ffmpeg binary; music works without it (MP3 + Opus via the built-in decoder).
FFMPEG_PATH=

# Container paths (keep as-is with docker-compose.yml).
DATA_DIR=/app/data
LOG_LEVEL=info
LOG_TO_FILE=false
BACKUP_KEEP=7

# Optional HTTP health endpoint (some hosts require a listening port).
HEALTH_PORT=
